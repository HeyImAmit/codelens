# =======================================================
# CodeLens Environment Variables Reference (.env.example)
# NEVER commit real credentials to version control.
# =======================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
# In local development: use port 5433 (host port of Docker Postgres)
# Inside Docker Compose: use DB_HOST=postgres and DB_PORT=5432
DB_USER=postgres
DB_HOST=localhost
DB_NAME=codelens
DB_PASSWORD=postgres
DB_PORT=5433
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_SUBMISSIONS=10

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=code-execution
RABBITMQ_PREFETCH=1

# Groq / LangChain AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_PROMPT_LENGTH=4000
AI_MAX_QUERY_LENGTH=2000
AI_MAX_SOURCE_CODE_LENGTH=15000

# Execution Sandbox Settings
EXECUTION_TIMEOUT_MS=10000
EXECUTION_MAX_OUTPUT_BYTES=65536
SUBMISSION_MAX_CODE_BYTES=50000

# Observability & Logging
LOG_LEVEL=info
